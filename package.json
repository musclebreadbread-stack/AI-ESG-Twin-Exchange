{
  "name": "ai-esg-twin-exchange",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:budget": "tsx tools/count-eslint-disable.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:property": "vitest --run --project property",
    "test:integration": "vitest --run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@supabase/supabase-js": "^2.49.0",
    "@supabase/ssr": "^0.6.0",
    "@prisma/client": "^6.9.0",
    "zod": "^3.24.0",
    "decimal.js": "^10.5.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.9.0",
    "vitest": "^3.2.0",
    "fast-check": "^4.1.0",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.27.0",
    "@eslint/js": "^9.27.0",
    "typescript-eslint": "^8.32.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0"
  }
}
